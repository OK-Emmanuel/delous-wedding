# Neon PostgreSQL connection string (pooled recommended)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# NextAuth / jose secret (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-secure-random-string

# Canonical public origin used in emails, absolute redirect URLs and QR codes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SendGrid transactional email (optional in development — emails stay queued without it)
SENDGRID_API_KEY=
SENDGRID_FROM="DELOUS '26 <invites@yourdomain.com>"
