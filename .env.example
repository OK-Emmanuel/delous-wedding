# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign admin session tokens (generate: openssl rand -hex 32)
AUTH_SECRET=

# Public URL of the deployed site (used in emails and QR links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend transactional email (optional in development — emails stay queued without it)
RESEND_API_KEY=
RESEND_FROM="DELOUS '26 <invites@example.com>"
